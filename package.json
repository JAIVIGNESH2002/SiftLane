{
  "name": "siftlane",
  "version": "0.1.0",
  "private": true,
  "description": "A calm RSS/Atom reader that groups repeated coverage into explainable story groups.",
  "license": "MIT",
  "engines": {
    "node": "22.18.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0",
    "clsx": "2.1.0",
    "drizzle-orm": "0.44.5",
    "next": "15.5.9",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "rss-parser": "3.13.0",
    "undici": "7.29.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.4",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.9",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
